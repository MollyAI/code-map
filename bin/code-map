#!/bin/sh
# code-map launcher — pick a JS runtime and exec the Node pipeline CLI.
#
# Claude Code runs plugin `!`-commands through a POSIX shell (git-bash on
# Windows), so this sh script is portable across macOS / Linux / Windows. If
# that ever stops being true, add a bin/code-map.cmd batch shim doing the same
# detection.
#
# This replaces the old `python3 scripts/*.py` invocations: no Python, no pip,
# no tree-sitter wheels. Grammars are WASM, loaded by web-tree-sitter, and the
# only prerequisite is a JS runtime (Node >=18 or Bun).
set -e

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PLUGIN_ROOT=$(CDPATH= cd -- "$HERE/.." && pwd)
CLI="$PLUGIN_ROOT/scripts/cli.mjs"

# `code-map root` prints the plugin's own install dir (no JS runtime needed).
# /code-map:build uses it to locate bundled templates/ without relying on
# CLAUDE_PLUGIN_ROOT being present in the shell — it is NOT, in slash commands
# (it is only set for hook / MCP / LSP / monitor subprocesses).
if [ "$1" = "root" ]; then printf '%s\n' "$PLUGIN_ROOT"; exit 0; fi

# Prefer node (validate >=18), then bun.
#
# --liftoff-only forces V8's baseline WASM compiler and skips the optimizing
# tier. The tree-sitter-swift grammar (~3MB) makes V8's background optimizer
# OOM ("Fatal out of memory: Zone"); we don't need optimized WASM for a
# short-lived one-shot parse anyway, and baseline-only starts faster.
if command -v node >/dev/null 2>&1; then
  MAJOR=$(node -e 'process.stdout.write(String(process.versions.node.split(".")[0]))' 2>/dev/null || echo 0)
  if [ "$MAJOR" -ge 18 ] 2>/dev/null; then
    exec node --liftoff-only "$CLI" "$@"
  fi
  echo "code-map: found Node $(node --version 2>/dev/null) but needs >=18." >&2
fi

if command -v bun >/dev/null 2>&1; then
  exec bun "$CLI" "$@"
fi

echo "code-map needs a JS runtime (Node >=18 or Bun)." >&2
echo "Install Node from https://nodejs.org, or:" >&2
echo "  macOS:   brew install node" >&2
echo "  Windows: winget install OpenJS.NodeJS" >&2
echo "  Linux:   use your package manager, or https://nodejs.org" >&2
exit 1
